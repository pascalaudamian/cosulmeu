# ==============================================================================
# VARIABILE SERVER-SIDE (NICIOADATĂ CU PREFIX VITE_ SAU NEXT_PUBLIC_)
# ==============================================================================

# NODE_ENV: development | test | production
NODE_ENV="development"

# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployment (used for CORS allowlist & self-links).
APP_URL="MY_APP_URL"

# ALLOWED_ORIGIN / ALLOWED_ORIGINS: Origini permise CORS în producție (separate prin virgulă)
# Ordine agregată CORS pe server: cosulmeu.online, www.cosulmeu.online, APP_URL, ALLOWED_ORIGIN, ALLOWED_ORIGINS, CORS_ALLOWED_ORIGINS
ALLOWED_ORIGIN="https://cosulmeu.online"
# ALLOWED_ORIGINS="https://cosulmeu.online,https://www.cosulmeu.online"

# ADMIN_API_KEY: Obligatoriu în producție pentru endpoint-urile /api/admin/* și /api/quality/* (fail-closed dacă lipsește)
ADMIN_API_KEY="MY_ADMIN_API_KEY"

# CRON_SECRET: Obligatoriu în producție pentru /api/cron/catalog-publish (Vercel Cron Bearer token)
CRON_SECRET="MY_CRON_SECRET"

# MONITORUL_PRETURILOR_API_KEY: Optional authorized API key for Consiliul Concurenței Open Data
MONITORUL_PRETURILOR_API_KEY="MY_MONITORUL_PRETURILOR_API_KEY"

# ==============================================================================
# SUPABASE (CLIENT + SERVER)
# Ordine prioritate Client (vite.config.ts):
#   URL:      VITE_SUPABASE_URL -> NEXT_PUBLIC_cosulmeuSUPABASE_URL -> SUPABASE_URL
#   Anon Key: VITE_SUPABASE_ANON_KEY -> NEXT_PUBLIC_cosulmeuSUPABASE_ANON_KEY -> SUPABASE_ANON_KEY
# Ordine prioritate Server (server.ts / src/db/index.ts):
#   URL:      SUPABASE_URL -> VITE_SUPABASE_URL -> NEXT_PUBLIC_cosulmeuSUPABASE_URL
# SERVICE_ROLE este STRICT SERVER-ONLY — nu prefixa niciodată cu VITE_!
# ==============================================================================
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SUPABASE_SERVICE_ROLE_KEY"
# VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# VITE_SUPABASE_REDIRECT_URL="https://cosulmeu.online"

# ==============================================================================
# PERSISTENȚĂ CENTRALIZATĂ POSTGRESQL (OPȚIONAL / MULTI-UTILIZATOR)
# Ordine prioritate Server (src/db/index.ts):
#   SQL_HOST+SQL_USER+SQL_DB_NAME -> SUPABASE_DB_URL -> POSTGRES_PRISMA_URL -> POSTGRES_URL -> DATABASE_URL -> POSTGRES_URL_NON_POOLING -> PGHOST+PGUSER+PGDATABASE
# ==============================================================================

# OPȚIUNEA 1: Conexiune Supabase sau PostgreSQL Standard prin URL (Recomandat Cloud/Vercel)
# DATABASE_URL="postgresql://postgres:MY_SECURE_PASSWORD@db.example.supabase.co:5432/postgres"
# POSTGRES_URL="postgresql://postgres:MY_SECURE_PASSWORD@db.example.supabase.co:5432/postgres"
# SUPABASE_DB_URL="postgresql://postgres:MY_SECURE_PASSWORD@db.example.supabase.co:5432/postgres"

# OPȚIUNEA 2: Google Cloud SQL (Platform-injected proxy socket)
# SQL_HOST="/cloudsql/project:region:instance"
# SQL_USER="cosul_app_user"
# SQL_PASSWORD="MY_SQL_USER_PASSWORD"
# SQL_DB_NAME="cosul_meu"

# OPȚIUNEA 3: Parametri standard PostgreSQL (Container Docker sau Server On-Premise)
# PGHOST="localhost"
# PGPORT="5432"
# PGUSER="postgres"
# PGPASSWORD="MY_PG_PASSWORD"
# PGDATABASE="cosul_meu"
# PGSSLMODE="prefer"
